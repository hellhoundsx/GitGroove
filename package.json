{
  "name": "gitclient",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop Git client with a visual commit graph",
  "main": "./out/main/index.js",
  "author": "Ricardo Gomes",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "e2e:setup": "node tools/e2e/setup-testrepo.mjs",
    "e2e": "node tools/e2e/run.mjs",
    "recon:targets": "node tools/gk-recon/cdp.mjs targets"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
